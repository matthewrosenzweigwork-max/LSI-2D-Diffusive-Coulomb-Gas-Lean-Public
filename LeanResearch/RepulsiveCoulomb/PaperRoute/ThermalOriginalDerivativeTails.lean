module

public import LeanResearch.RepulsiveCoulomb.PaperRoute.ThermalOriginalReference
public import LeanResearch.RepulsiveCoulomb.PaperRoute.ThermalCartesianDensityTails
public import LeanResearch.RepulsiveCoulomb.EquilibriumBranchMultiIndexTail

@[expose] public section

/-! The complete original thermal derivative-tail clauses, first for a supplied
physical reference, then for the reference independently constructed by the
NEW direct-method/Green/EL/regularity/maximum-Laplacian route.

The frozen MultiIndexTail import is used ONLY for the literal successive
Cartesian derivative definition and its generic operator-norm comparison.
Every quantitative higher-derivative bound below is generated by the NEW
exterior radial-profile induction, unit-sphere conversion and compact-disk
argument. None of the frozen reference-tail or selected-reference endpoints
is invoked. Constants are positive real numbers, hence finite. -/
noncomputable section
open MeasureTheory Real Set Filter
open scoped Topology ContDiff
namespace RepulsiveCoulomb.PaperRoute

/-- The actual convolution of a supplied physical reference is smooth by the
NEW raw-input regularity/bootstrap producer. Smoothness of the convolution is
not a field of the reference record and is not silently assumed. -/
theorem thermalReference_potential_contDiff {β : ℝ} (hβ : 0 < β)
    (R : EquilibriumConstructedReference β) :
    ContDiff ℝ (⊤ : ℕ∞) (equilibriumDensityPotential R.density) := by
  exact (thermal_radial_EL_smooth hβ R.smooth.continuous.measurable
    R.positive R.cap R.integrable R.mass_one R.secondMoment_integrable
    R.radial R.eulerLagrange).2

/-- Every physical Frechet order, with the exact beta+n polynomial exponent.
The sole tail field consumed is the previously established zeroth-order EL
bound; all higher orders are new proof-body dependencies. -/
theorem thermalReference_iteratedFDeriv_tail {β : ℝ} (hβ : 0 < β)
    (R : EquilibriumConstructedReference β) (n : ℕ) :
    ∃ C : ℝ, 0 < C ∧ ∀ x : ℂ,
      ‖iteratedFDeriv ℝ n R.density x‖ ≤
        C * (1 + ‖x‖) ^ (β + (n : ℝ)) * Real.exp (-β * ‖x‖ ^ 2 / 2) := by
  exact thermal_actual_density_cartesian_tails hβ R.smooth.continuous.measurable
    R.positive R.cap R.integrable R.mass_one R.secondMoment_integrable
    R.radial R.eulerLagrange R.smooth (thermalReference_potential_contDiff hβ R)
    R.tailConstant_pos R.tail n

/-- Literal successive real/imaginary Cartesian derivatives, with no physical
rescaling and exact beta+|alpha|. The generic comparison theorem identifies
these actual partial derivatives with full derivative evaluation. -/
theorem thermalReference_multiIndex_tail {β : ℝ} (hβ : 0 < β)
    (R : EquilibriumConstructedReference β) (α : Fin 2 → ℕ) :
    ∃ C : ℝ, 0 < C ∧ ∀ x : ℂ,
      |equilibriumMultiIndexDerivative α R.density x| ≤
        C * (1 + ‖x‖) ^ (β + ((α 0 + α 1 : ℕ) : ℝ)) *
          Real.exp (-β * ‖x‖ ^ 2 / 2) := by
  obtain ⟨C, hC, hb⟩ := thermalReference_iteratedFDeriv_tail hβ R (α 0 + α 1)
  exact ⟨C, hC, fun x =>
    (equilibriumMultiIndexDerivative_norm_le R.smooth α x).trans (hb x)⟩

/-- Original inputs only: the NEW physical reference and every Frechet order. -/
theorem thermalConstructedReference_iteratedFDeriv_tail {β : ℝ} (hβ : 0 < β)
    (n : ℕ) :
    ∃ C : ℝ, 0 < C ∧ ∀ x : ℂ,
      ‖iteratedFDeriv ℝ n (thermalConstructedReference β hβ).density x‖ ≤
        C * (1 + ‖x‖) ^ (β + (n : ℝ)) * Real.exp (-β * ‖x‖ ^ 2 / 2) :=
  thermalReference_iteratedFDeriv_tail hβ (thermalConstructedReference β hβ) n

/-- The complete literal eq:mu-tail clause for the NEW selected equilibrium.
No supplied reference, smoothness, derivative, or tail certificate remains. -/
theorem thermalConstructedReference_multiIndex_tail {β : ℝ} (hβ : 0 < β)
    (α : Fin 2 → ℕ) :
    ∃ C : ℝ, 0 < C ∧ ∀ x : ℂ,
      |equilibriumMultiIndexDerivative α (thermalConstructedReference β hβ).density x| ≤
        C * (1 + ‖x‖) ^ (β + ((α 0 + α 1 : ℕ) : ℝ)) *
          Real.exp (-β * ‖x‖ ^ 2 / 2) :=
  thermalReference_multiIndex_tail hβ (thermalConstructedReference β hβ) α

end RepulsiveCoulomb.PaperRoute
