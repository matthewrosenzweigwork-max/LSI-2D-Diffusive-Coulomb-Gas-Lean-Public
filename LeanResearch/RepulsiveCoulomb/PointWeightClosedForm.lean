import LeanResearch.RepulsiveCoulomb.PointWeightClosability

/-! The closed weighted form generated by the prescribed smooth core.
The realization in L2 is proved injective, rather than assumed in the
closure definition. The graph norm uses the real Euclidean gradient.
-/
noncomputable section
open MeasureTheory Set Filter TopologicalSpace
open scoped ENNReal Topology
namespace RepulsiveCoulomb

theorem pointCoreJet_add {m : ℕ} {γ : ℝ} (hγ : 0 < γ)
    {a : Fin m → ℝ} (ha : ∀ j, 0 ≤ a j) (y : Fin m → ℂ)
    (φ ψ : TestFunction (pointDomain a y) ℝ ⊤) :
    pointCoreJet hγ ha y (φ + ψ) = pointCoreJet hγ ha y φ + pointCoreJet hγ ha y ψ := by
  apply Lp.ext
  filter_upwards [pointCoreJet_coe hγ ha y (φ + ψ), pointCoreJet_coe hγ ha y φ,
    pointCoreJet_coe hγ ha y ψ, Lp.coeFn_add (pointCoreJet hγ ha y φ) (pointCoreJet hγ ha y ψ)]
    with z hsum hφ hψ hadd
  rw [hsum, hadd, Pi.add_apply, hφ, hψ]
  apply (WithLp.prodContinuousLinearEquiv 2 ℝ ℝ ℂ).injective
  change ((φ + ψ) z, gradient ((φ + ψ : TestFunction (pointDomain a y) ℝ ⊤) : ℂ → ℝ) z) =
    (φ z, gradient (φ : ℂ → ℝ) z) + (ψ z, gradient (ψ : ℂ → ℝ) z)
  apply Prod.ext
  · rfl
  · exact TauCeti.gradient_add (φ.contDiff.differentiable (by simp) z)
      (ψ.contDiff.differentiable (by simp) z)

theorem pointCoreJet_smul {m : ℕ} {γ : ℝ} (hγ : 0 < γ)
    {a : Fin m → ℝ} (ha : ∀ j, 0 ≤ a j) (y : Fin m → ℂ)
    (c : ℝ) (φ : TestFunction (pointDomain a y) ℝ ⊤) :
    pointCoreJet hγ ha y (c • φ) = c • pointCoreJet hγ ha y φ := by
  apply Lp.ext
  filter_upwards [pointCoreJet_coe hγ ha y (c • φ), pointCoreJet_coe hγ ha y φ,
    Lp.coeFn_smul c (pointCoreJet hγ ha y φ)] with z hsmul hφ hcoe
  rw [hsmul, hcoe, Pi.smul_apply, hφ]
  apply (WithLp.prodContinuousLinearEquiv 2 ℝ ℝ ℂ).injective
  change ((c • φ) z, gradient ((c • φ : TestFunction (pointDomain a y) ℝ ⊤) : ℂ → ℝ) z) =
    c • (φ z, gradient (φ : ℂ → ℝ) z)
  apply Prod.ext
  · rfl
  · simpa using (TauCeti.gradient_const_smul (𝕜 := ℝ) (f := (φ : ℂ → ℝ)) (x := z) c)

def pointCoreJetLinear {m : ℕ} {γ : ℝ} (hγ : 0 < γ)
    {a : Fin m → ℝ} (ha : ∀ j, 0 ≤ a j) (y : Fin m → ℂ) :
    TestFunction (pointDomain a y) ℝ ⊤ →ₗ[ℝ] PointJetL2 γ a y where
  toFun := pointCoreJet hγ ha y
  map_add' := pointCoreJet_add hγ ha y
  map_smul' := pointCoreJet_smul hγ ha y

def pointFormSubmodule {m : ℕ} {γ : ℝ} (hγ : 0 < γ)
    {a : Fin m → ℝ} (ha : ∀ j, 0 ≤ a j) (y : Fin m → ℂ) :
    ClosedSubmodule ℝ (PointJetL2 γ a y) :=
  (LinearMap.range (pointCoreJetLinear hγ ha y)).closure

theorem coe_pointFormSubmodule {m : ℕ} {γ : ℝ} (hγ : 0 < γ)
    {a : Fin m → ℝ} (ha : ∀ j, 0 ≤ a j) (y : Fin m → ℂ) :
    (pointFormSubmodule hγ ha y : Set (PointJetL2 γ a y)) = pointCoreGraph hγ ha y := by
  rw [pointFormSubmodule, Submodule.coe_closure, LinearMap.coe_range]
  rfl

/-- The completion of the prescribed core in its value/gradient Hilbert norm. -/
abbrev PointFormDomain {m : ℕ} {γ : ℝ} (hγ : 0 < γ)
    {a : Fin m → ℝ} (ha : ∀ j, 0 ≤ a j) (y : Fin m → ℂ) :=
  (pointFormSubmodule hγ ha y).toSubmodule

instance pointFormDomain_completeSpace {m : ℕ} {γ : ℝ} (hγ : 0 < γ)
    {a : Fin m → ℝ} (ha : ∀ j, 0 ≤ a j) (y : Fin m → ℂ) :
    CompleteSpace (PointFormDomain hγ ha y) :=
  (pointFormSubmodule hγ ha y).isClosed.completeSpace_coe

def pointFormValueL {m : ℕ} {γ : ℝ} (hγ : 0 < γ)
    {a : Fin m → ℝ} (ha : ∀ j, 0 ≤ a j) (y : Fin m → ℂ) :
    PointFormDomain hγ ha y →L[ℝ] Lp ℝ 2 (pointMeasure γ a y) :=
  (pointJetValueL γ a y).comp (pointFormSubmodule hγ ha y).toSubmodule.subtypeL

def pointFormGradientL {m : ℕ} {γ : ℝ} (hγ : 0 < γ)
    {a : Fin m → ℝ} (ha : ∀ j, 0 ≤ a j) (y : Fin m → ℂ) :
    PointFormDomain hγ ha y →L[ℝ] Lp ℂ 2 (pointMeasure γ a y) :=
  (pointJetGradientL γ a y).comp (pointFormSubmodule hγ ha y).toSubmodule.subtypeL

theorem pointFormValueL_eq_zero_iff {m : ℕ} {γ : ℝ} (hγ : 0 < γ)
    {a : Fin m → ℝ} (ha : ∀ j, 0 ≤ a j) (y : Fin m → ℂ)
    (u : PointFormDomain hγ ha y) : pointFormValueL hγ ha y u = 0 ↔ u = 0 := by
  constructor
  · intro hu
    apply Subtype.ext
    exact pointCoreGraph_zero_of_value_zero hγ ha y
      (by rw [← coe_pointFormSubmodule]; exact u.property) hu
  · intro hu
    simp [hu]

theorem pointFormValueL_injective {m : ℕ} {γ : ℝ} (hγ : 0 < γ)
    {a : Fin m → ℝ} (ha : ∀ j, 0 ≤ a j) (y : Fin m → ℂ) :
    Function.Injective (pointFormValueL hγ ha y) := by
  intro u v huv
  apply sub_eq_zero.mp
  apply (pointFormValueL_eq_zero_iff hγ ha y (u - v)).mp
  rw [map_sub, huv, sub_self]

def pointFormEnergy {m : ℕ} {γ : ℝ} (hγ : 0 < γ)
    {a : Fin m → ℝ} (ha : ∀ j, 0 ≤ a j) (y : Fin m → ℂ)
    (u : PointFormDomain hγ ha y) : ℝ := ‖pointFormGradientL hγ ha y u‖ ^ 2

theorem pointForm_norm_sq {m : ℕ} {γ : ℝ} (hγ : 0 < γ)
    {a : Fin m → ℝ} (ha : ∀ j, 0 ≤ a j) (y : Fin m → ℂ)
    (u : PointFormDomain hγ ha y) :
    ‖u‖ ^ 2 = ‖pointFormValueL hγ ha y u‖ ^ 2 + pointFormEnergy hγ ha y u :=
  pointJet_norm_sq γ a y u

theorem pointFormEnergy_eq_integral {m : ℕ} {γ : ℝ} (hγ : 0 < γ)
    {a : Fin m → ℝ} (ha : ∀ j, 0 ≤ a j) (y : Fin m → ℂ)
    (u : PointFormDomain hγ ha y) :
    pointFormEnergy hγ ha y u = ∫ z, ‖pointFormGradientL hγ ha y u z‖ ^ 2 ∂pointMeasure γ a y := by
  rw [pointFormEnergy, ← real_inner_self_eq_norm_sq, L2.inner_def]
  apply integral_congr_ae
  filter_upwards [] with z
  exact real_inner_self_eq_norm_sq _

theorem pointFormEnergy_nonneg {m : ℕ} {γ : ℝ} (hγ : 0 < γ)
    {a : Fin m → ℝ} (ha : ∀ j, 0 ≤ a j) (y : Fin m → ℂ)
    (u : PointFormDomain hγ ha y) : 0 ≤ pointFormEnergy hγ ha y u := sq_nonneg _

end RepulsiveCoulomb
