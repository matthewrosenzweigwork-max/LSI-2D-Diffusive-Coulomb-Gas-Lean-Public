theorem pointForm_uniform_lsi {γ Q : ℝ} (hγ : 0 < γ) :
    ∃ K : ℝ, 0 < K ∧
      ∀ (m : ℕ) (a : Fin m → ℝ) (ha : ∀ j, 0 ≤ a j) (y : Fin m → ℂ),
      (∑ j, a j ≤ Q) → ∀ u : PointFormDomain hγ ha y,
      entropy (pointMeasure γ a y) (fun x => (pointFormValueL hγ ha y u x) ^ 2) ≤
        ((K * pointFormEnergy hγ ha y u : ℝ) : EReal) := by
  obtain ⟨K, hK, hk⟩ := pointCore_uniform_tight_lsi (Q := Q) hγ
  refine ⟨K, hK, ?_⟩
  intro m a ha y hQ u
  have h := pointForm_defective_lsi_of_core (C := K) (D := 0) hγ ha y
    (fun φ => by simpa only [zero_mul, add_zero] using hk m a ha y hQ φ) u
  simpa only [zero_mul, add_zero] using h

/-- Literal full-domain weighted Gaussian PI and LSI, uniform in every finite
configuration subject only to the total-exponent cap. -/
theorem planar_weighted_gaussian_inequalities {γ Q : ℝ} (hγ : 0 < γ) :
    ∃ C ρ : ℝ, 0 < C ∧ 0 < ρ ∧
      ∀ (m : ℕ) (a : Fin m → ℝ) (ha : ∀ j, 0 ≤ a j) (y : Fin m → ℂ),
      (∑ j, a j ≤ Q) → ∀ u : PointFormDomain hγ ha y,
      variance (pointFormValueL hγ ha y u : ℂ → ℝ) (pointMeasure γ a y) ≤
        C * (∫ x, ‖pointFormGradientL hγ ha y u x‖ ^ 2 ∂pointMeasure γ a y) ∧
      entropy (pointMeasure γ a y) (fun x => (pointFormValueL hγ ha y u x) ^ 2) ≤
        (((2 / ρ) * (∫ x, ‖pointFormGradientL hγ ha y u x‖ ^ 2 ∂pointMeasure γ a y) : ℝ) : EReal) := by
  obtain ⟨C, hC, hc⟩ := pointForm_uniform_poincare (Q := Q) hγ
  obtain ⟨K, hK, hk⟩ := pointForm_uniform_lsi (Q := Q) hγ
  refine ⟨C, 2 / K, hC, div_pos (by norm_num) hK, ?_⟩
  intro m a ha y hQ u
  have hid : 2 / (2 / K) = K := by field_simp
  constructor
  · simpa only [pointFormEnergy_eq_integral] using hc m a ha y hQ u
  · simpa only [hid, pointFormEnergy_eq_integral] using hk m a ha y hQ u

end RepulsiveCoulomb
