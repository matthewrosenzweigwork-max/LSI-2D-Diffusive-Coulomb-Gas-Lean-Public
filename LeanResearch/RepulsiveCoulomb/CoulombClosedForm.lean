module

public import LeanResearch.RepulsiveCoulomb.CoulombClosability
public meta import Lean.Meta.Tactic.AuxLemma
public meta import Lean.Elab.Command

@[expose] public section

/-! The complete closed physical form generated by the original full
collision-free smooth core. Its realization in value L2 is proved injective. -/
noncomputable section
open Set MeasureTheory Filter TopologicalSpace
open scoped Topology ENNReal
namespace RepulsiveCoulomb

run_cmd Lean.modifyEnv fun env => Lean.Meta.auxLemmasExt.setState env {}
theorem coulombCoreJet_add {N : ℕ} {β : ℝ} (hβ : 0 < β)
    (φ ψ : TestFunction (coulombDomain N) ℝ ⊤) :
    coulombCoreJet hβ (φ + ψ) = coulombCoreJet hβ φ + coulombCoreJet hβ ψ := by
  apply Lp.ext
  filter_upwards [coulombCoreJet_coe hβ (φ + ψ), coulombCoreJet_coe hβ φ, coulombCoreJet_coe hβ ψ,
    Lp.coeFn_add (coulombCoreJet hβ φ) (coulombCoreJet hβ ψ)] with z hsum hφ hψ hadd
  rw [hsum, hadd, Pi.add_apply, hφ, hψ]
  apply (WithLp.prodContinuousLinearEquiv 2 ℝ ℝ (CoulombConfig N)).injective
  change ((φ + ψ) z, gradient ((φ + ψ : TestFunction (coulombDomain N) ℝ ⊤) : CoulombConfig N → ℝ) z) =
    (φ z, gradient (φ : CoulombConfig N → ℝ) z) + (ψ z, gradient (ψ : CoulombConfig N → ℝ) z)
  apply Prod.ext
  · rfl
  · exact TauCeti.gradient_add (φ.contDiff.differentiable (by simp) z) (ψ.contDiff.differentiable (by simp) z)

run_cmd Lean.modifyEnv fun env => Lean.Meta.auxLemmasExt.setState env {}
theorem coulombCoreJet_smul {N : ℕ} {β : ℝ} (hβ : 0 < β)
    (c : ℝ) (φ : TestFunction (coulombDomain N) ℝ ⊤) :
    coulombCoreJet hβ (c • φ) = c • coulombCoreJet hβ φ := by
  apply Lp.ext
  filter_upwards [coulombCoreJet_coe hβ (c • φ), coulombCoreJet_coe hβ φ, Lp.coeFn_smul c (coulombCoreJet hβ φ)]
    with z hsmul hφ hcoe
  rw [hsmul, hcoe, Pi.smul_apply, hφ]
  apply (WithLp.prodContinuousLinearEquiv 2 ℝ ℝ (CoulombConfig N)).injective
  change ((c • φ) z, gradient ((c • φ : TestFunction (coulombDomain N) ℝ ⊤) : CoulombConfig N → ℝ) z) =
    c • (φ z, gradient (φ : CoulombConfig N → ℝ) z)
  apply Prod.ext
  · rfl
  · simpa using (TauCeti.gradient_const_smul (𝕜 := ℝ) (f := (φ : CoulombConfig N → ℝ)) (x := z) c)

run_cmd Lean.modifyEnv fun env => Lean.Meta.auxLemmasExt.setState env {}
def coulombCoreJetLinear (N : ℕ) {β : ℝ} (hβ : 0 < β) :
    TestFunction (coulombDomain N) ℝ ⊤ →ₗ[ℝ] CoulombJetL2 N β where
  toFun := coulombCoreJet hβ
  map_add' := coulombCoreJet_add hβ
  map_smul' := coulombCoreJet_smul hβ

run_cmd Lean.modifyEnv fun env => Lean.Meta.auxLemmasExt.setState env {}
def coulombFormSubmodule (N : ℕ) {β : ℝ} (hβ : 0 < β) : ClosedSubmodule ℝ (CoulombJetL2 N β) :=
  (LinearMap.range (coulombCoreJetLinear N hβ)).closure

theorem coe_coulombFormSubmodule (N : ℕ) {β : ℝ} (hβ : 0 < β) :
    (coulombFormSubmodule N hβ : Set (CoulombJetL2 N β)) = coulombCoreGraph N hβ := by
  rw [coulombFormSubmodule, Submodule.coe_closure, LinearMap.coe_range]
  rfl

run_cmd Lean.modifyEnv fun env => Lean.Meta.auxLemmasExt.setState env {}
abbrev CoulombFormDomain (N : ℕ) {β : ℝ} (hβ : 0 < β) := (coulombFormSubmodule N hβ).toSubmodule

instance coulombFormDomain_completeSpace (N : ℕ) {β : ℝ} (hβ : 0 < β) : CompleteSpace (CoulombFormDomain N hβ) :=
  (coulombFormSubmodule N hβ).isClosed.completeSpace_coe

run_cmd Lean.modifyEnv fun env => Lean.Meta.auxLemmasExt.setState env {}
def coulombFormValueL (N : ℕ) {β : ℝ} (hβ : 0 < β) :
    CoulombFormDomain N hβ →L[ℝ] Lp ℝ 2 (coulombMeasure N β) :=
  (coulombJetValueL N β).comp (coulombFormSubmodule N hβ).toSubmodule.subtypeL

run_cmd Lean.modifyEnv fun env => Lean.Meta.auxLemmasExt.setState env {}
def coulombFormGradientL (N : ℕ) {β : ℝ} (hβ : 0 < β) :
    CoulombFormDomain N hβ →L[ℝ] Lp (CoulombConfig N) 2 (coulombMeasure N β) :=
  (coulombJetGradientL N β).comp (coulombFormSubmodule N hβ).toSubmodule.subtypeL

theorem coulombFormValueL_eq_zero_iff (N : ℕ) {β : ℝ} (hβ : 0 < β)
    (u : CoulombFormDomain N hβ) : coulombFormValueL N hβ u = 0 ↔ u = 0 := by
  constructor
  · intro hu
    apply Subtype.ext
    exact coulombCoreGraph_zero_of_value_zero hβ (by rw [← coe_coulombFormSubmodule]; exact u.property) hu
  · intro hu
    simp [hu]

theorem coulombFormValueL_injective (N : ℕ) {β : ℝ} (hβ : 0 < β) : Function.Injective (coulombFormValueL N hβ) := by
  intro u v huv
  apply sub_eq_zero.mp
  apply (coulombFormValueL_eq_zero_iff N hβ (u - v)).mp
  rw [map_sub, huv, sub_self]

run_cmd Lean.modifyEnv fun env => Lean.Meta.auxLemmasExt.setState env {}
def coulombFormEnergy (N : ℕ) {β : ℝ} (hβ : 0 < β) (u : CoulombFormDomain N hβ) : ℝ :=
  ‖coulombFormGradientL N hβ u‖ ^ 2

theorem coulombForm_norm_sq (N : ℕ) {β : ℝ} (hβ : 0 < β) (u : CoulombFormDomain N hβ) :
    ‖u‖ ^ 2 = ‖coulombFormValueL N hβ u‖ ^ 2 + coulombFormEnergy N hβ u := coulombJet_norm_sq N β u

theorem coulombFormEnergy_eq_integral (N : ℕ) {β : ℝ} (hβ : 0 < β) (u : CoulombFormDomain N hβ) :
    coulombFormEnergy N hβ u = ∫ z, ‖coulombFormGradientL N hβ u z‖ ^ 2 ∂coulombMeasure N β := by
  rw [coulombFormEnergy, ← real_inner_self_eq_norm_sq, L2.inner_def]
  apply integral_congr_ae
  filter_upwards [] with z
  exact real_inner_self_eq_norm_sq _

theorem coulombFormEnergy_nonneg (N : ℕ) {β : ℝ} (hβ : 0 < β) (u : CoulombFormDomain N hβ) :
    0 ≤ coulombFormEnergy N hβ u := sq_nonneg _

end RepulsiveCoulomb
